{
  "name": "obsidian-auto-icon",
  "version": "0.1.0",
  "description": "Automatically assign an icon to each note based on its content.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "jest --passWithNoTests",
    "smoke": "npm run build && node scripts/smoke.js main.js"
  },
  "keywords": [
    "obsidian",
    "icon",
    "frontmatter",
    "classify",
    "lucide"
  ],
  "author": "rosswang",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "jest": "^30.5.1",
    "obsidian": "^1.13.1",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}